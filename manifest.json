{
  "name": "NOVEX AI — Personal AI Assistant",
  "short_name": "NOVEX",
  "description": "ChatGPT-level AI assistant with memory, flashcards, quiz, doubt scanner, language learning, real-time search, and 82 themes including 30 3D themes.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050112",
  "theme_color": "#050112",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["education", "productivity", "utilities", "ai"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "NOVEX AI home on desktop"
    },
    {
      "src": "/screenshots/home-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "NOVEX AI home on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "New Chat",
      "short_name": "New Chat",
      "description": "Start a fresh conversation",
      "url": "/?action=new-chat",
      "icons": [{ "src": "/icons/shortcut-new.png", "sizes": "96x96" }]
    },
    {
      "name": "Quiz Mode",
      "short_name": "Quiz",
      "description": "Take a quiz on any topic",
      "url": "/?action=quiz",
      "icons": [{ "src": "/icons/shortcut-quiz.png", "sizes": "96x96" }]
    },
    {
      "name": "Doubt Scanner",
      "short_name": "Scan",
      "description": "Scan a photo of your doubt",
      "url": "/?action=scan",
      "icons": [{ "src": "/icons/shortcut-scan.png", "sizes": "96x96" }]
    },
    {
      "name": "Learn Language",
      "short_name": "Lingua",
      "description": "Continue your language lessons",
      "url": "/?action=lingua",
      "icons": [{ "src": "/icons/shortcut-lingua.png", "sizes": "96x96" }]
    },
    {
      "name": "Flashcards",
      "short_name": "Cards",
      "description": "Review your flashcards",
      "url": "/?action=flashcards",
      "icons": [{ "src": "/icons/shortcut-cards.png", "sizes": "96x96" }]
    },
    {
      "name": "My Progress",
      "short_name": "Progress",
      "description": "View level and badges",
      "url": "/?action=profile",
      "icons": [{ "src": "/icons/shortcut-profile.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/plain"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+novex",
      "url": "/?deeplink=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif"],
        "application/pdf": [".pdf"],
        "text/plain": [".txt", ".md"]
      }
    }
  ],
  "related_applications": [],
  "iarc_rating_id": "",
  "shortcuts_icons_purposes": "any"
}